# Pravaas API — copy to .env and fill in secrets
# cp .env.example .env

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pravaas?schema=public"

# Auth
JWT_SECRET="dev-secret-change-in-production"
JWT_EXPIRES_IN="7d"

# OpenAI — required for booking screenshot extraction
OPENAI_API_KEY="sk-your-openai-api-key"

# File uploads (relative to apps/api/)
UPLOAD_DIR="./uploads"

# Server
PORT=3000
