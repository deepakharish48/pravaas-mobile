generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String             @id @default(uuid())
  email     String             @unique
  password  String
  name      String
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  bookings  Booking[]
  documents IdentityDocument[]
}

model Booking {
  id                 String        @id @default(uuid())

  userId             String
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)

  imagePath          String

  hotelName          String?
  destination        String?
  itineraryData      String?
  guestName          String?

  checkIn            DateTime?
  checkOut           DateTime?

  checkedInAt        DateTime?
  checkedOutAt       DateTime?

  confirmationNumber String?

  roomType           String?
  numberOfGuests     Int?

  totalPrice         String?
  currency           String?

  identityType       DocumentType?
  identityName       String?
  identityNumber     String?

  rawExtractedData   String?

  status             BookingStatus @default(PENDING)

  qrCode             String?

  guestQrs           HotelGuestQr[] @relation("HotelReservationGuests")
  sourceGuestQrs     HotelGuestQr[] @relation("GuestSourceBooking")

  cForm              CForm?

  hotelCheckedInBy   String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([confirmationNumber])
  @@index([status])
}

model IdentityDocument {
  id                 String             @id @default(uuid())
  userId             String
  documentType       DocumentType
  displayName        String?
  documentNumber     String?
  fullName           String?
  nationality        String?
  dateOfBirth        DateTime?
  expiryDate         DateTime?
  imagePath          String
  verificationStatus VerificationStatus @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  rawExtractedData   String?
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
}

enum DocumentType {
  PASSPORT
  AADHAAR
  DRIVING_LICENSE
  VISA
  OTHER
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

model HotelGuestQr {
  id               String   @id @default(uuid())
  bookingId        String
  booking          Booking  @relation("HotelReservationGuests", fields: [bookingId], references: [id], onDelete: Cascade)
  sourceBookingId  String?
  sourceBooking    Booking? @relation("GuestSourceBooking", fields: [sourceBookingId], references: [id], onDelete: SetNull)
  guestName        String
  identityType     String?
  identityName     String?
  identityNumber   String?
  qrPayload        String
  scannedAt        DateTime @default(now())
  checkedInAt      DateTime?

  @@unique([bookingId, identityNumber])
  @@unique([bookingId, sourceBookingId])
  @@index([bookingId])
  @@index([sourceBookingId])
}

model CForm {
  id                 String   @id @default(uuid())
  bookingId          String   @unique
  booking            Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  data               String
  savedAt            DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([bookingId])
}
