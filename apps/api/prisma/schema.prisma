generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  bookings  Booking[]
  documents IdentityDocument[]
}

model Booking {
  id                 String        @id @default(uuid())
  userId             String
  user               User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  imagePath          String
  hotelName          String?
  guestName          String?
  checkIn            DateTime?
  checkOut           DateTime?
  confirmationNumber String?
  roomType           String?
  numberOfGuests     Int?
  totalPrice         String?
  currency           String?
  rawExtractedData   String?
  status             BookingStatus @default(PENDING)
  qrCode             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([userId])
  @@index([confirmationNumber])
}

model IdentityDocument {
  id                 String   @id @default(uuid())

  userId             String
  user               User @relation(fields: [userId], references: [id], onDelete: Cascade)

  documentType       DocumentType

  documentNumber     String?
  fullName           String?
  nationality        String?

  dateOfBirth        DateTime?
  expiryDate         DateTime?

  imagePath          String

  verificationStatus VerificationStatus @default(PENDING)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  CANCELLED
}
enum DocumentType {
  PASSPORT
  AADHAAR
  DRIVING_LICENSE
  VISA
}
enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}